# Public URL of the backend's edge proxy (the volcano repository on Render), without a trailing "/".
# Used by the browser and by the Next.js server. Locally: `docker compose up` in the backend → :10000.
NEXT_PUBLIC_API_URL=http://localhost:10000

# Optional: base URL of the realtime hub when it is NOT behind the same host as the API (for example
# when the three services run locally without the edge proxy: http://localhost:8002). The client
# turns it into ws(s)://…/ws. Leave it empty in production.
NEXT_PUBLIC_REALTIME_URL=

# Secret for POST /api/revalidate (on-demand revalidation of the ISR pages). It must match the
# backend's REVALIDATE_SECRET. Optional in development.
REVALIDATE_SECRET=

# Optional: Google Maps JavaScript API key for the map with Google's terrain and satellite layers.
# Restrict it in Google Cloud to your Vercel domain (https://your-site.vercel.app/*) and to the
# "Maps JavaScript API" only. Without a key (or when Google rejects it) the map uses Leaflet with
# Esri layers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
